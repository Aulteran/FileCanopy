# Copy to .env beside compose.yaml. Images are not public yet; this is a preparation template.
# Choose an explicitly published version. No default/latest and no registry login required
# once anonymous-pull acceptance has passed for the public release.
FILECANOPY_VERSION=
FILECANOPY_IMAGE_PREFIX=ghcr.io/aulteran/filecanopy
# Generate a URL-safe secret, e.g. openssl rand -hex 32. No spaces, $, #, @, / or :.
# This password is embedded in a database URL. Keep .env private (chmod 600).
POSTGRES_PASSWORD=
# Separate host directories, relative to compose.yaml. Linux: owned by UID/GID below.
FILECANOPY_LIBRARY_PATH=./library
FILECANOPY_APP_DATA_PATH=./app-data
FILECANOPY_UID=10001
FILECANOPY_GID=10001
FILECANOPY_HTTP_PORT=8080
FILECANOPY_COOKIE_SECURE=true
# Empty: generated one-time token printed in API logs. No default credentials.
FILECANOPY_SETUP_TOKEN=
# Use a unique value for each installation. Do not change it on an existing install.
COMPOSE_PROJECT_NAME=filecanopy
# Optional TLS reverse proxy; trust only its exact address, never a whole shared network.
FILECANOPY_PUBLIC_URL=
FILECANOPY_TRUSTED_PROXIES=
FILECANOPY_HSTS=false
# Optional profiles, independently enabled. No AI provider is configured by this file.
# COMPOSE_PROFILES=converter,ocr
# FILECANOPY_CONVERTER_URL=unix:///run/converter/converter.sock
# FILECANOPY_OCR_URL=unix:///run/ocr/ocr.sock
# Heartbeat tier only; not needed for file operations or built-in background processing.
# COMPOSE_PROFILES=workers
# FILECANOPY_REDIS_URL=redis://redis:6379/0
