# FileCanopy quick start: copy to .env in the same folder as compose.yaml, then edit it.
# Keep .env private (chmod 600). Never commit it. Placeholders below are not secrets.

# Image tag to run. "beta" follows the public beta and moves when a new beta is published, so run
# `docker compose pull` to get updates. For a fixed install use an exact version, for example 1.0.0.
FILECANOPY_VERSION=beta
# Registry prefix for the images. Leave as is unless you mirror the images elsewhere.
FILECANOPY_IMAGE_PREFIX=ghcr.io/aulteran/filecanopy

# REQUIRED. Database password. Use a long URL-safe random value, for example: openssl rand -hex 32
# Do not use spaces, $, #, @, / or :. Set it before the first start; changing it later needs a database reset.
POSTGRES_PASSWORD=

# Folders for your files and app-private data, relative to this folder. Create them before starting
# (mkdir library app-data). On Linux the API runs as FILECANOPY_UID:FILECANOPY_GID and must own both.
FILECANOPY_LIBRARY_PATH=./library
FILECANOPY_APP_DATA_PATH=./app-data
FILECANOPY_UID=10001
FILECANOPY_GID=10001

# Port on this computer where the web app is published (127.0.0.1 only).
FILECANOPY_HTTP_PORT=8080
# Keep true. Browsers accept sign-in cookies on http://localhost; use HTTPS for any other address.
FILECANOPY_COOKIE_SECURE=true
# Optional. Empty = a one-time token is printed in the API log (see README, first-run setup).
# If you set your own, use at least 32 characters, for example: openssl rand -hex 32
FILECANOPY_SETUP_TOKEN=
# Use a unique name for each installation on the same Docker host.
COMPOSE_PROJECT_NAME=filecanopy

# Behind a TLS reverse proxy only: the address you type in the browser, and the proxy's exact address.
FILECANOPY_PUBLIC_URL=
FILECANOPY_TRUSTED_PROXIES=
FILECANOPY_HSTS=false

# Optional features, all off by default. See the README and docs/guides for details.
# Office previews (converter) and OCR run in separate containers. Enable with COMPOSE_PROFILES:
# COMPOSE_PROFILES=converter,ocr
# FILECANOPY_CONVERTER_URL=unix:///run/converter/converter.sock
# FILECANOPY_OCR_URL=unix:///run/ocr/ocr.sock
# Heartbeat worker tier (not needed for normal use):
# COMPOSE_PROFILES=workers
# FILECANOPY_REDIS_URL=redis://redis:6379/0
# Outbound email (invitations, password reset). Needs FILECANOPY_PUBLIC_URL.
# FILECANOPY_SMTP_HOST=
# FILECANOPY_SMTP_PORT=587
# FILECANOPY_SMTP_SECURITY=starttls
# FILECANOPY_SMTP_USERNAME=
# FILECANOPY_SMTP_PASSWORD=
# FILECANOPY_SMTP_FROM=
# Single sign-on (OpenID Connect). Needs FILECANOPY_PUBLIC_URL. Password sign-in stays available.
# FILECANOPY_OIDC_ISSUER=
# FILECANOPY_OIDC_CLIENT_ID=
# FILECANOPY_OIDC_CLIENT_SECRET=
# Limits (defaults shown in the README configuration section):
# FILECANOPY_MAX_UPLOAD_BYTES=10737418240
# FILECANOPY_SEARCH_ENABLED=true
