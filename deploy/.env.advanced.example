# Advanced settings. Add only the lines you need to your .env (next to compose.yaml); everything here is
# optional and shown with its default. Keep .env private (chmod 600) and never commit it.
# Docs: docs/guides/ (production, hardening, ai, mcp, semantic-search, inbound-mailbox, google-sign-in).

# ---- Install --------------------------------------------------------------------------------
# beta follows the public beta (docker compose pull to update). Pin an exact version, e.g. 1.0.0, to stay on it.
# FILECANOPY_VERSION=beta
# FILECANOPY_IMAGE_PREFIX=ghcr.io/aulteran/filecanopy
# Name of this install; use a different one for a second install on the same Docker host.
# COMPOSE_PROJECT_NAME=filecanopy
# Linux: the user the app runs as. It must own the library and app-data folders (see `id -u`, `id -g`).
# FILECANOPY_UID=10001
# FILECANOPY_GID=10001
# Use a named Docker volume instead of a folder on disk: set the value to  library  and  app-data.
# FILECANOPY_LIBRARY_PATH=./library
# FILECANOPY_APP_DATA_PATH=./app-data
# Bring your own database password (only when moving an existing install to this compose file).
# POSTGRES_PASSWORD=
# Your own first-run token (32+ characters). Empty = a one-time token is printed in the API log.
# FILECANOPY_SETUP_TOKEN=
# Keep true. Browsers accept sign-in cookies on http://localhost; any other address needs HTTPS.
# FILECANOPY_COOKIE_SECURE=true

# ---- Behind a TLS reverse proxy (deploy/proxy/README.md) -------------------------------------
# FILECANOPY_PUBLIC_URL=https://files.example.org
# The proxy's own exact address as the app sees it; never a whole network. Empty trusts nobody.
# FILECANOPY_TRUSTED_PROXIES=
# FILECANOPY_HSTS=false
# FILECANOPY_ALLOWED_ORIGINS=
# Proxy running in Docker (compose.proxy.yaml): the name of its network, see `docker network ls`.
# FILECANOPY_PROXY_NETWORK=

# ---- Outbound mail: invitations, password reset (needs FILECANOPY_PUBLIC_URL) ----------------
# FILECANOPY_SMTP_HOST=
# FILECANOPY_SMTP_PORT=587
# FILECANOPY_SMTP_SECURITY=starttls
# FILECANOPY_SMTP_USERNAME=
# FILECANOPY_SMTP_PASSWORD=
# FILECANOPY_SMTP_FROM=

# ---- Inbound mailbox, read-only IMAP (docs/guides/inbound-mailbox.md) ------------------------
# FILECANOPY_IMAP_HOST=
# FILECANOPY_IMAP_PORT=993
# FILECANOPY_IMAP_SECURITY=ssl
# FILECANOPY_IMAP_USERNAME=
# FILECANOPY_IMAP_PASSWORD=
# FILECANOPY_IMAP_PERSONAL_ADDRESS=
# FILECANOPY_IMAP_INGEST_ADDRESS=
# FILECANOPY_IMAP_AUTHSERV_ID=

# ---- Single sign-on, OpenID Connect (docs/guides/google-sign-in.md). Needs FILECANOPY_PUBLIC_URL ----
# FILECANOPY_OIDC_ISSUER=
# FILECANOPY_OIDC_CLIENT_ID=
# FILECANOPY_OIDC_CLIENT_SECRET=
# FILECANOPY_OIDC_LABEL=Single sign-on
# FILECANOPY_OIDC_HOSTED_DOMAIN=
# Break-glass: true ignores the "provider-only sign-in" switch at startup.
# FILECANOPY_FORCE_LOCAL_LOGIN=false

# ---- Limits (bytes unless noted) ------------------------------------------------------------
# FILECANOPY_MAX_UPLOAD_BYTES=10737418240
# FILECANOPY_MAX_IMPORT_ENTRIES=100000
# FILECANOPY_MAX_ZIP_BYTES=10737418240
# FILECANOPY_MAX_ZIP_UNCOMPRESSED_BYTES=53687091200
# FILECANOPY_IMPORT_ENTRY_RETENTION_DAYS=90

# ---- Search, AI hosts, MCP --------------------------------------------------------------------
# Index file text for full-text search. false = filename search only.
# FILECANOPY_SEARCH_ENABLED=true
# Hosts accepted for local AI and embedding servers (empty = any private address).
# FILECANOPY_AI_LOCAL_HOSTS=
# FILECANOPY_SEMANTIC_PAUSE_MS=200
# Read-only MCP interface, off by default (docs/guides/mcp.md).
# FILECANOPY_MCP_ENABLED=false
# 32+ character secret for Confidential PINs. Empty = generated and kept in app-data.
# FILECANOPY_PIN_PEPPER=

# ---- Optional containers ----------------------------------------------------------------------
# Off by default. Turn on with profiles (and the matching URL) in .env:
# COMPOSE_PROFILES=ocr,converter,workers
# FILECANOPY_OCR_URL=unix:///run/ocr/ocr.sock                     (scanned PDFs and pictures)
# FILECANOPY_CONVERTER_URL=unix:///run/converter/converter.sock   (Word/Excel/PowerPoint previews)
# FILECANOPY_REDIS_URL=redis://redis:6379/0                       (heartbeat worker tier)
# Two more are separate files because they depend on your machine; add one with a second -f:
#   docker compose -f compose.yaml -f compose.backup.yaml up -d   (in-app backups, FILECANOPY_BACKUP_PATH on ANOTHER disk)
#   docker compose -f compose.yaml -f compose.proxy.yaml up -d    (join your reverse proxy's Docker network)
# FILECANOPY_BACKUP_PATH=
