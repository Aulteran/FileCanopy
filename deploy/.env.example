# Copy to deploy/.env and set a strong password. Never commit deploy/.env.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Host directories. LIBRARY is your ordinary, portable document tree (bind mount);
# APP_DATA is app-private data and must NOT be inside LIBRARY (or the reverse).
# Relative paths resolve against the deploy/ directory.
FILECANOPY_LIBRARY_PATH=../library
FILECANOPY_APP_DATA_PATH=../app-data

# On Linux, run the API as a user that owns the two directories above (see `id -u`, `id -g`).
# FILECANOPY_UID=10001
# FILECANOPY_GID=10001

# Optional workers (document processing arrives in later milestones). To enable, uncomment this
# and start with:  docker compose --profile workers up -d --build
# FILECANOPY_REDIS_URL=redis://redis:6379/0

# Web port, published on localhost only. Put a TLS reverse proxy in front for remote access.
FILECANOPY_HTTP_PORT=8080

# First-run setup. Until an administrator exists, creating one requires a one-time token. Leave
# empty to have the API generate one and print it once in its log:
#   docker compose logs api | grep "SETUP TOKEN"
# Or choose your own (at least 32 characters, e.g. the output of the command above). There are no
# default credentials and no open registration.
FILECANOPY_SETUP_TOKEN=

# Session cookies are Secure (HTTPS only). Browsers exempt http://localhost; set to false only for
# plain-HTTP access from another machine on a trusted LAN, and prefer a TLS reverse proxy instead.
# FILECANOPY_COOKIE_SECURE=true
