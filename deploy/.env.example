# Copy to deploy/.env and set a strong password. Never commit deploy/.env.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Host directories. LIBRARY is your ordinary, portable document tree (bind mount);
# APP_DATA is app-private data and must NOT be inside LIBRARY (or the reverse).
# Relative paths resolve against the deploy/ directory.
FILECANOPY_LIBRARY_PATH=../library
FILECANOPY_APP_DATA_PATH=../app-data

# On Linux, run the API as a user that owns the two directories above (see `id -u`, `id -g`).
# FILECANOPY_UID=10001
# FILECANOPY_GID=10001

# Optional workers (document processing arrives in later milestones). To enable, uncomment this
# and start with:  docker compose --profile workers up -d --build
# FILECANOPY_REDIS_URL=redis://redis:6379/0

# Web port, published on localhost only. Put a TLS reverse proxy in front for remote access.
FILECANOPY_HTTP_PORT=8080

# Reverse proxy (Nginx Proxy Manager, Caddy, nginx, Traefik, Cloudflare Tunnel). Step by step
# examples are in deploy/proxy/README.md. Nothing here is needed for local use.
# The address people type in the browser (scheme and host, no path). Recommended: sign-in then
# works even if the proxy does not forward the original Host header.
# FILECANOPY_PUBLIC_URL=https://files.example.org
# More browser origins to accept, comma-separated.
# FILECANOPY_ALLOWED_ORIGINS=
# IPs or CIDR ranges of the reverse proxies directly in front of this app (the address the web
# container sees them at, not your public IP). Only these may tell the app a visitor's real IP
# through X-Forwarded-For and that a request was https. Empty = trust nobody, and then every
# visitor appears to come from the proxy, so sign-in throttling and the audit log are shared.
# Trust the proxy's own single address, not a whole Docker network (other containers on it
# could then claim any visitor address). Wide ranges such as 0.0.0.0/0 are refused. Example:
# FILECANOPY_TRUSTED_PROXIES=172.18.0.5
# Send "Strict-Transport-Security" (HSTS). Browsers then refuse plain HTTP for a year, which is
# hard to undo, so enable it only once HTTPS works for good.
# FILECANOPY_HSTS=false

# First-run setup. Until an administrator exists, creating one requires a one-time token. Leave
# empty to have the API generate one and print it once in its log:
#   docker compose logs api | grep "SETUP TOKEN"
# Or choose your own (at least 32 characters, e.g. the output of the command above). There are no
# default credentials and no open registration.
FILECANOPY_SETUP_TOKEN=

# Session cookies are Secure (HTTPS only). Browsers exempt http://localhost; set to false only for
# plain-HTTP access from another machine on a trusted LAN, and prefer a TLS reverse proxy instead.
# FILECANOPY_COOKIE_SECURE=true

# Largest accepted upload in bytes (default 10 GiB). The API enforces it while streaming.
# FILECANOPY_MAX_UPLOAD_BYTES=10737418240

# Setup import and folder upload. A zip is uploaded to the app-data staging area and extracted by
# the server; these bound one import. Defaults: 100000 entries, 10 GiB archive, 50 GiB extracted.
# The extracted size is counted while streaming, and an entry that expands more than 1000:1 is refused.
# FILECANOPY_MAX_IMPORT_ENTRIES=100000
# FILECANOPY_MAX_ZIP_BYTES=10737418240
# FILECANOPY_MAX_ZIP_UNCOMPRESSED_BYTES=53687091200
# A manifest (folder listing) body may weigh about 320 bytes per allowed entry (32 MB by default);
# the bundled nginx caps it at 32m, so raise both together if you raise the entry limit.

# Import reports (the per-file rows of a finished import) are deleted this many days after the
# import completes; the batch summary is kept. Stopped imports and imports with failed files are
# never pruned automatically.
# FILECANOPY_IMPORT_ENTRY_RETENTION_DAYS=90
# Unfinished folder uploads one person may have at once.
# FILECANOPY_MAX_OPEN_FOLDER_UPLOADS=5
# An import that is writing a file pauses scanning of its folder for at most this many seconds in a
# row; after that scanning proceeds and the folder shows "scan delayed".
# FILECANOPY_SCAN_PAUSE_CEILING_SECONDS=1800

# Office previews (M10). Word, Excel and PowerPoint open in the viewer through a sealed converter
# container (about 700 MB image, no network, no access to your files). To turn it on, uncomment BOTH:
# COMPOSE_PROFILES=converter
# FILECANOPY_CONVERTER_URL=unix:///run/converter/converter.sock
# Without it, Office files show "download instead" and everything else works as before.
# Search and OCR (M11). Text of your files is indexed in the background so full-text search
# works (filenames are always searchable). Private files are indexed only after you allow local
# processing in Preview settings; Confidential files are never indexed. To turn off text indexing:
# FILECANOPY_SEARCH_ENABLED=false
# Scanned PDFs and pictures become searchable through a sealed OCR container (Tesseract, no
# network, no access to your files). To turn it on, uncomment BOTH (add `,converter` to the
# profiles if you use both):
# COMPOSE_PROFILES=ocr
# FILECANOPY_OCR_URL=unix:///run/ocr/ocr.sock
#
# Larger files than this (bytes) are not previewed:
# FILECANOPY_PREVIEW_OFFICE_MAX_BYTES=52428800

# Optional backups (M06c). To use them, start with the override file:
#   docker compose -f docker-compose.yml -f docker-compose.backup.yml up -d --build
# and uncomment the next line. This is a host directory on a SEPARATE disk or share (a copy on the
# same disk is not a backup); it must not be, contain or sit inside the library or app-data
# directories, and the API user (FILECANOPY_UID/GID) must own it. Then turn backups on in the web
# app. Archives are encrypted by default; the recovery key is shown once and is never stored.
# FILECANOPY_BACKUP_PATH=../backups

# --- Outbound mail (optional, M12) -----------------------------------------------------------
# Lets the administrator email invitation and password-reset links and shows "Forgot your
# password?" on the sign-in page. Needs FILECANOPY_PUBLIC_URL (links in mail use it). Leave the
# host empty to keep mail off: the administrator then hands over each one-time link.
# FILECANOPY_SMTP_HOST=smtp.example.org
# FILECANOPY_SMTP_PORT=587
# starttls (default, port 587), ssl (port 465) or none (only for a relay on this machine).
# FILECANOPY_SMTP_SECURITY=starttls
# FILECANOPY_SMTP_USERNAME=
# FILECANOPY_SMTP_PASSWORD=
# FILECANOPY_SMTP_FROM=filecanopy@example.org

# --- Single sign-on with OIDC (optional, M12) ------------------------------------------------
# Works with Authentik, Authelia, Keycloak and other OpenID Connect providers. Needs
# FILECANOPY_PUBLIC_URL. Register this redirect address at the provider (the Users page shows it):
#   <FILECANOPY_PUBLIC_URL>/api/v1/auth/oidc/callback
# The issuer must be exactly the "issuer" the provider's discovery document reports (Authentik:
# https://auth.example.org/application/o/<slug>/ with the trailing slash; Authelia:
# https://auth.example.org). Accounts are never created or matched by email: the administrator
# invites people and each person links the provider from Account (or accepts the invitation
# through it). Password sign-in stays available.
# FILECANOPY_OIDC_ISSUER=
# Do not change the issuer text later (not even a trailing slash): links are stored against it
# and would stop matching.
# FILECANOPY_OIDC_CLIENT_ID=
# FILECANOPY_OIDC_CLIENT_SECRET=
# FILECANOPY_OIDC_LABEL=Authentik
# Google: issuer https://accounts.google.com, see docs/guides/google-sign-in.md. Optional, Google
# Workspace only: accept only this hosted domain.
# FILECANOPY_OIDC_HOSTED_DOMAIN=example.com

# --- Provider-only sign-in and recovery (M12b) -------------------------------------------------
# An administrator can switch password sign-in off on the Users page. If the provider then breaks:
#   docker compose exec api python -m app.auth.cli oidc-only off
# or set this to true and restart (it ignores the switch until you remove it again):
# FILECANOPY_FORCE_LOCAL_LOGIN=true
# Confidential PINs are hashed with a secret kept outside the database. Empty = generated into the
# app-data volume (not part of FileCanopy backups). If it is lost, PINs stop working and people set
# a new one with their password or an emailed link (people with no password need SMTP).
# FILECANOPY_PIN_PEPPER=
