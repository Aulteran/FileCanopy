# Optional. Copy to .env next to compose.yaml only if you want to change something. No password is needed.
FILECANOPY_VERSION=beta
FILECANOPY_HTTP_PORT=8080
# Folders for your files and app-private data. Created next to compose.yaml if they do not exist.
FILECANOPY_LIBRARY_PATH=./library
FILECANOPY_APP_DATA_PATH=./app-data
# Everything else (reverse proxy, mail, sign-in, limits, search ...): see .env.advanced.example.
