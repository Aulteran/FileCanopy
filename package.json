{
  "name": "filecanopy",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Self-hosted, folder-first file manager with optional AI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "secret-scan": "node scripts/secret-scan.mjs",
    "docs:links": "node scripts/docs-links.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "check": "npm run lint && npm run format:check && npm run test && npm run secret-scan && npm run docs:links",
    "check:api": "node scripts/api-check.mjs",
    "test:compose": "node scripts/compose-test.mjs",
    "check:full": "npm run check && npm run check:web && npm run check:api && npm run test:compose && npm run test:e2e",
    "check:web": "npm --prefix apps/web run check",
    "test:e2e": "node scripts/e2e-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
