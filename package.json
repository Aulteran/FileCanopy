{
  "name": "filecanopy",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, folder-first file manager with optional AI (working codename).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "npm run lint && npm run format:check && npm run test && npm run secret-scan"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
